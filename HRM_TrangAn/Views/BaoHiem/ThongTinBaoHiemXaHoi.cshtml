
@{
    ViewBag.Title = "Thông tin bảo hiểm xã hội của nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/thongtinbaohiem.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-database"></i> Danh mục</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-users"></i> Thông tin bảo hiểm xã hội của nhân viên</b>
</span>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
    <button class="k-button bg-orange" onclick="openAcceptWindow()"> <i class="fa fa-wrench"> Áp dụng</i> </button>

</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <input type="hidden" id="ID" />
        <div style="display: flex">
            <div style="width: 100%; flex-direction:row; display: flex">
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Mức lương:<span style="color:red">*</span></label>
                    <input id="MucLuongDongBaoHiem" type="number" oninput="tinhBaoHiem()" style="width:100%" class="k-textbox" />
                </div>
            </div>
        </div>
        <hr />
        <div style="display: flex">
            <div style="width: 50%; flex-direction:column; display: flex">
                <div class="form-group">
                    <label style="width:100%; font-size: 16px">Công ty đóng:</label>
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Bảo hiểm xã hội:<span style="color:red">*</span></label>
                    <input id="SDLDBaoHiemXaHoi" type="number" oninput="" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Bảo hiểm y tế:<span style="color:red">*</span></label>
                    <input id="SDLDBaoHiemYTe" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Bảo hiểm thất nghiệp:<span style="color:red">*</span></label>
                    <input id="SDLDBaoHiemThatNghiep" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Tổng công ty đóng:<span style="color:red">*</span></label>
                    <input id="SDLDTong" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Tổng công đóng thực tế:<span style="color:red">*</span></label>
                    <input id="SDLDThucTe" type="text" style="width:100%" class="k-textbox" />
                </div>
            </div>
            <div style="width: 50%; flex-direction:column; display: flex">
                <div class="form-group">
                    <label style="width:100%; font-size: 16px">Người lao động đóng:</label>
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Bảo hiểm xã hội:<span style="color:red">*</span></label>
                    <input id="NLDBaoHiemXaHoi" type="number" oninput="" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Bảo hiểm y tế:<span style="color:red">*</span></label>
                    <input id="NLDBaoHiemYTe" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Bảo hiểm thất nghiệp:<span style="color:red">*</span></label>
                    <input id="NLDBaoHiemThatNghiep" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Tổng người lao động đóng:<span style="color:red">*</span></label>
                    <input id="NLDTong" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Tổng người lao động đóng thực tế:<span style="color:red">*</span></label>
                    <input id="NLDThucTe" type="text" style="width:100%" class="k-textbox" />
                </div>
            </div>
        </div>
        <hr />
        <div style="display: flex">
            <div style="width: 100%; flex-direction:row; display: flex">
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Tổng:<span style="color:red">*</span></label>
                    <input id="TongTien" type="text" style="width:100%" class="k-textbox" readonly />
                </div>
                <div style="flex:1" class="form-group">
                    <label style="width:59%">Mô tả:<span style="color:red"></span></label>
                    <input id="MoTa" type="text" style="width:100%" class="k-textbox" />
                </div>
            </div>
        </div>
        <div style="display: flex">
            <div style="width: 100%; flex-direction:row; display: flex">
                <div style="flex:1" class="form-group">
                    <label style="width:59%">Ghi chú:<span style="color:red"></span></label>
                    <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>
                </div>
            </div>
        </div>
    </form>
</div>
<div id="windowAddNhanVien">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="LuuAddNhanVien()"> <i class="fa fa-plus-square"> Lưu </i></button>
    </div>

    <div class="form-group">
        <input id="ID_TaiKhoan" type="hidden" />
    </div>
    <div class="form-group">
        <label>Danh sách nhân viên:</label>
        <div id="gridAddNhanVien"></div>
    </div>
</div>
<div style="visibility:hidden" id="windowADCS">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="LuuApDung()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="HuyApDung()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <input type="hidden" id="ID" />
        <div style="display: flex">

            <div style="width: 33%; flex-direction:column; display: flex">
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Mức lương đóng bảo hiểm:<span style="color:red">*</span></label>
                    <input id="MucLuongDongBaoHiemRead" type="number" style="width:100%" class="k-textbox" readonly />
                </div>

                <div style="flex:1" class="form-group">
                    <label style="width:30%">Tỷ lệ đóng bảo hiểm:<span style="color:red">*</span></label>
                    <input id="TyLeDongBaoHiemRead" type="number" style="width:100%" class="k-textbox" readonly />
                </div>

            </div>
            <div style="width: 33%; flex-direction:column; display: flex">
                <div class="form-group valid" toggle-valid="ComboThoiGianBatDau">
                    <label style="width:100%">Ngày bắt đầu:<span style="color:red">*</span></label>
                    <input id="ThoiGianBatDauRead" type="text" class="input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ComboThoiGianKetThuc">
                    <label style="width:100%">Ngày kết thúc:<span style="color:red">*</span></label>
                    <input id="ThoiGianKetThucRead" type="text" class="input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
            </div>
            <div style="width: 33%; flex-direction:column; display: flex">
                <div style="flex:1" class="form-group">
                    <label style="width:100%">Mức lương công ty đóng:<span style="color:red">*</span></label>
                    <input id="CongTyDongRead" type="number" style="width:100%" class="k-textbox" readonly />
                </div>

                <div style="flex:1" class="form-group">
                    <label style="width:100%">Mức lương nhân viên đóng:<span style="color:red">*</span></label>
                    <input id="NhanVienDongRead" type="number" style="width:100%" class="k-textbox" readonly />
                </div>
            </div>
        </div>
        <div class="form-group">
            <div id="gridNhanVien"></div>
        </div>
    </form>
</div>