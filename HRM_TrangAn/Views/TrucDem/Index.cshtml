@{
    ViewBag.Title = "Quản lý lịch trực đêm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/quanlytrucdem.js"></script>
<style>
    .k-scheduler-monthview .k-scheduler-table td {
        /*height: 80px !important;*/
    }

    .k-other-month {
        color: #fff;
        background-color: #c5c5c5;
    }


    .k-event {
        height: 15px !important;
        min-height: 10px !important;
    }
</style>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-calendar"></i> Quản lý lịch trực đêm</b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Phòng ban</label>
        <input style="width:100%" id="treePhongBan" />
    </div>
    <div class="col-sm-5">
        <label style="width:100%">Nhân viên</label>
        <input style="width:100%" id="comboNhanVien" />
    </div>
    <div class="col-sm-3">
        <label style="width:100%"> </label>
        <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Xem báo cáo </i></button>
        <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel </i></button>
    </div>
</div>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-3">
        <label style="width:100%">Từ ngày</label>
        <input style="width:100%" id="TuNgay" />
    </div>
    <div class="col-sm-3">
        <label style="width:100%">Đến ngày</label>
        <input style="width:100%" id="DenNgay" />
    </div>
  
</div>
<div id="tabstrip" style="margin-top:10px;">
    <ul>
        <li class="k-state-active">
            Lịch trực đêm
        </li>
        <li>
            Dữ liệu chi tiết
        </li>
    </ul>
    <div style="border:none;padding:0px;margin:0px;">
        <div id="scheduler"></div>
    </div>
    <div style="border:none;padding:0px;margin:0px;">
        <div id="grid"></div>
    </div>
</div>

<script id="eventschedule_template" type="text/x-kendo-template">
    <div style="float:left;height:15px;font-size:11px;width:55%;text-align:right;line-height:15px">
        #= title #
    </div>
</script>

<div id="windowAddTrucDem">
    <div class="form-group" style="margin-top:10px;">
        <label style="width:100%">Ngày</label>
        <input style="width:100%" id="Ngay" />
    </div>
    <div class="form-group">
        <label>Danh sách nhân viên:</label>
        <div id="gridAddTrucDem"></div>
    </div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="orders"></div>
</script>