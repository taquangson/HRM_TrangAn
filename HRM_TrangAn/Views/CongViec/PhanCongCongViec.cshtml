
@{
    ViewBag.Title = "Phân công công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-cell {
        display: inline-grid;
        padding-block: 10px;
    }
</style>
<script src="~/Scripts/js/phancongcongviec.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Quản lý phân công việc</b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Ngày</label>
        <input style="width:100%" id="Ngay" />
    </div>
    <div class="col-sm-3">
        <label style="width:100%;height:15px;"> </label>
        <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Xem báo cáo </i></button>
    </div>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-orange" onclick="openUpdateWindow()"> <i class="fa fa-wrench"> Xác nhận</i> </button>
    <button class="k-button bg-orange" onclick="quickUpdate()"> <i class="fa fa-wrench"> Xác nhận nhanh</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel </i></button>
</div>
<div class="row">
    <div id="grid"></div>
</div>

<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button id="btnSave" class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <div style="width:100%;float:left">
            <div style="width:50%;float:left">
                <div class="form-group valid" toggle-valid="NgayLamViec">
                    <label style="width:100%">Ngày làm việc: <span style="color:red">*</span></label>
                    <input id="NgayLamViec" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="ComboCongViec">
                    <label style="width:100%">Nội dung công việc: <span style="color:red">*</span></label>
                    <input id="ComboCongViec" type="text" class=" input" />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="ComboNguoiGiamSat">
                    <label style="width:100%">Người giám sát: <span style="color:red">*</span></label>
                    <input id="ComboNguoiGiamSat" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="DiaDiem">
                    <label style="width:100%">Địa điểm: <span style="color:red">*</span></label>
                    <textarea id="DiaDiem" type="text" rows="2" style="width:100%;padding:2px;" class="k-textbox"></textarea>

                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>


            </div>
            <div style="width: 50%; float: left">

                <div class="form-group valid" toggle-valid="Cong">
                    <label style="width:100%">Công/người: <span style="color:red">*</span></label>
                    <input id="Cong" type="number" class="k-textbox input" onchange="UpdateTimeDK(this.value)" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianDuKien" hidden>
                    <label style="width:100%">Thời gian: <span style="color:red">*</span></label>
                    <input id="ThoiGianDuKien" type="number" class="k-textbox input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianBatDauDuKien">
                    <label style="width:100%">Thời gian bắt đầu: <span style="color:red">*</span></label>
                    <input id="ThoiGianBatDauDuKien" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianKetThucDuKien">
                    <label style="width:100%">Thời gian kết thúc: <span style="color:red">*</span></label>
                    <input id="ThoiGianKetThucDuKien" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="SoNguoiDuKien">
                    <label style="width:100%">Số lao động: <span style="color:red">*</span></label>
                    <input id="SoNguoiDuKien" type="number" class="k-textbox input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group">
                    <label style="width:100%">Ghi chú: </label>
                    <textarea id="GhiChu" type="text" rows="2" style="width:100%;padding:2px;" class="k-textbox"></textarea>

                </div>
            </div>
        </div>
        <div style="width:100%;float:left">
            <div class="form-group">
                <label>Danh sách người được phân công:</label>
                <div id="gridNhanVien"></div>
            </div>
        </div>
    </form>
</div>

<div id="windowUpdate">
    <div class="toolBarMenu">
        <button id="btnUpdate" class="k-button bg-blue" onclick="Update()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formUpdate">
        <div class="form-group">
            <input id="IDUpdate" type="hidden" />
        </div>
        <div style="width:100%;float:left">
            <div style="width:50%;float:left">

                <div class="form-group valid" toggle-valid="NgayLamViecDK">
                    <label style="width:100%">Ngày làm việc: <span style="color:red">*</span></label>
                    <input id="NgayLamViecDK" type="text" class="input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="TenCongViecDK">
                    <label style="width:100%">Nội dung công việc: <span style="color:red">*</span></label>
                    <input id="TenCongViecDK" type="text" class="k-textbox input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="NguoiGiamSatDK">
                    <label style="width:100%">Người giám sát: <span style="color:red">*</span></label>
                    <input id="NguoiGiamSatDK" type="text" class="k-textbox input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="DiaDiemDK">
                    <label style="width:100%">Địa điểm: <span style="color:red">*</span></label>
                    <input id="DiaDiemDK" type="text" class="k-textbox input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
            </div>
            <div style="width: 50%; float: left">

                <div class="form-group valid" toggle-valid="CongDK">
                    <label style="width:100%">Công/người: <span style="color:red">*</span></label>
                    <input id="CongDK" type="text" class="k-textbox input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianDuKienDK" hidden>
                    <label style="width:100%">Thời gian: <span style="color:red">*</span></label>
                    <input id="ThoiGianDuKienDK" type="number" class="k-textbox input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianBatDauDuKienDK">
                    <label style="width:100%">Thời gian bắt đầu: <span style="color:red">*</span></label>
                    <input id="ThoiGianBatDauDuKienDK" type="text" class="input" readonly/>
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianKetThucDuKienDK">
                    <label style="width:100%">Thời gian kết thúc: <span style="color:red">*</span></label>
                    <input id="ThoiGianKetThucDuKienDK" type="text" class="input" readonly/>
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="SoNguoiDK">
                    <label style="width:100%">Số lao động: <span style="color:red">*</span></label>
                    <input id="SoNguoiDK" type="text" class="k-textbox input" readonly />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>


            </div>
        </div>

        <div style="width:100%;float:left">
            <div class="form-group">
                <label>Danh sách người được phân công:</label>
                <div id="gridNhanVienDK"></div>
            </div>
        </div>
        <div style="width:100%;float:left">
            <div class="form-group">
                <label style="font-size: 20px">Xác nhận công việc phân công:</label>
            </div>
        </div>
        <div style="width:100%;float:left">
            <div style="width:50%;float:left">

                <div class="form-group valid" toggle-valid="ComboCongViecThucTe">
                    <label style="width:100%">Nội dung công việc: <span style="color:red">*</span></label>
                    <input id="ComboCongViecThucTe" type="text" class=" input" />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="TenCongViecThucTe" hidden>
                    <label style="width:100%">Nội dung công việc: <span style="color:red">*</span></label>
                    <input id="TenCongViecThucTe" type="text" class="k-textbox input" />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>
                <div class="form-group valid" toggle-valid="ComboNguoiGiamSatThucTe">
                    <label style="width:100%">Người giám sát: <span style="color:red">*</span></label>
                    <input id="ComboNguoiGiamSatThucTe" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>

                </div>

                <div class="form-group">
                    <label style="width:100%">Ghi chú: </label>
                    <textarea id="GhiChu" type="text" rows="2" style="width:100%;padding:2px;" class="k-textbox"></textarea>

                </div>
            </div>
            <div style="width: 50%; float: left">

                <div class="form-group valid" toggle-valid="CongThucTe">
                    <label style="width:100%">Công/người: <span style="color:red">*</span></label>
                    <input id="CongThucTe" type="number" class="k-textbox input" onchange="UpdateTimeTT(this.value)" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianThucTe" hidden>
                    <label style="width:100%">Thời gian: <span style="color:red">*</span></label>
                    <input id="ThoiGianThucTe" type="number" class="k-textbox input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianBatDauThucTe">
                    <label style="width:100%">Thời gian bắt đầu: <span style="color:red">*</span></label>
                    <input id="ThoiGianBatDauThucTe" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>
                <div class="form-group valid" toggle-valid="ThoiGianKetThucThucTe">
                    <label style="width:100%">Thời gian kết thúc: <span style="color:red">*</span></label>
                    <input id="ThoiGianKetThucThucTe" type="text" class="input" />
                    <span class="fa fa-exclamation-triangle icon"></span>
                </div>

            </div>
        </div>
        <div style="width:100%;float:left">
            <div class="form-group">
                <label>Danh sách người được phân công thực tế:</label>
                <div id="gridNhanVienThucTe"></div>
            </div>
        </div>
    </form>
</div>
<div id="windowNhanVien">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="LuuAddNhanVien()"> <i class="fa fa-plus-square"> Lưu </i></button>
    </div>
    <div class="form-group">
        <label>Danh sách nhân viên:</label>
        <div id="gridAddNhanVien"></div>
    </div>
</div>
<div id="windowNhanVienToNhom">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="LuuAddNhanVienToNhom()"> <i class="fa fa-plus-square"> Lưu </i></button>
    </div>
    <div class="form-group">
        <label>Danh sách nhân viên:</label>
        <div id="gridAddNhanVienToNhom"></div>
    </div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="orders"></div>
</script>