
@{
    ViewBag.Title = "Quản lý đi muộn - về sớm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/quanlydimuonvesom.js"></script>
<div id="rootContainer" style="display:none">
    <div class="row">
        <h2><b>Lịch sử chấm công muộn - về sớm</b></h2>
    </div>
    <div class="row" style="margin-top:10px;">
        <div class="col-sm-2">
            <label style="width:100%">Phòng ban</label>
            <input style="width:100%" id="treePhongBan" />
        </div>
        <div class="col-sm-2">
            <label style="width:100%">Từ ngày</label>
            <input style="width:100%" id="TuNgay" />
        </div>
        <div class="col-sm-2">
            <label style="width:100%">Đến ngày</label>
            <input style="width:100%" id="DenNgay" />
        </div>
        <div class="col-sm-3">
            <label style="width:100%"> </label>
            <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Xem dữ liệu </i></button>
            <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel </i></button>
        </div>
    </div>
    <div class="row" style="margin-top:20px;">
        <div id="grid"></div>
    </div>
</div>

<div style="visibility:hidden" id="windowXuPhat">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
            <input id="ID_TaiKhoan" type="hidden" />
        </div>
        <div class="form-group valid" toggle-valid="TenNhanVien">
            <label style="width:100%">Tên nhân viên: </label>
            <input id="TenNhanVien" readonly type="text" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="NgayPhat">
            <label style="width:100%">Ngày vi phạm: </label>
            <input id="NgayPhat" readonly type="text" class=" input" />
        </div>
        <div class="form-group valid">
            <label style="width:100%">Lỗi vi phạm:<span style="color:red">*</span></label>
            <input id="ComboLoi" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="SoTien">
            <label style="width:100%">Số tiền phạt/Người: <span style="color:red">*</span></label>
            <input id="SoTien" type="number" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group">
            <label style="width:100%">Ghi chú:</label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>
        </div>
    </form>
</div>

<script type="text/x-kendo-template" id="template">
    <div class="orders"></div>
</script>