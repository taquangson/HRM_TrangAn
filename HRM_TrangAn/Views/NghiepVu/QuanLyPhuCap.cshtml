
@{
    ViewBag.Title = "Quản lý phụ cấp nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-cell {
        display: inline-grid;
        padding-block: 10px;
    }
</style>
<script src="~/Scripts/js/quanlyphucap.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-arrows-h"></i> Quản lý phụ cấp</b>
</span>
<div class="row" style="margin-bottom:10px">
    <div class="col-sm-2">
        <label style="width:100%">Từ ngày</label>
        <input style="width:100%" id="TuNgay" />
    </div>
    <div class="col-sm-2">
        <label style="width:100%">Đến ngày</label>
        <input style="width:100%" id="DenNgay" />
    </div>
    <button class="k-button bg-blue" onclick="TimKiem()" style="margin-top: 26px"> <i class="fa fa-search"> Xem ngày hưởng phụ cấp </i></button>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <div class="form-group valid" toggle-valid="NhanVien">
            <label style="width:100%">Nhân Viên: <span style="color:red">*</span></label>
            <input id="NhanVien" type="text" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="Tien">
            <label style="width:100%">Số Tiền: <span style="color:red">*</span></label>
            <input id="Tien" type="number" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group" toggle-valid="NoiDung">
            <label style="width:100%">Nội Dung: <span style="color:red">*</span></label>
            <textarea id="NoiDung" type="text" style="width:100%" class="k-textbox"></textarea>
        </div>
        <div class="form-group" toggle-valid="NgayHuongPhuCap">
            <label style="width:100%">Ngày hưởng phụ cấp: <span style="color:red">*</span></label>
            <input id="NgayHuongPhuCap" />
        </div>
    </form>
</div>

