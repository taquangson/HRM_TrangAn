    </div>
    <form id="formUpdate3">

        <div class="form-group valid" toggle-valid="SoTienSua">
            <label style="width:100%">Số tiền sửa: <span style="color:red">*</span></label>
            <input id="SoTienSua" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group">
            <label style="width:100%">Ghi chú:</label>
            <textarea id="GhiChu3" type="text" style="width:100%" class="k-textbox"></textarea>
