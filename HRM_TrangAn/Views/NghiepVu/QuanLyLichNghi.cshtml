@{
    ViewBag.Title = "Quản lý lịch nghỉ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-cell {
        display: inline-grid;
        padding-block: 10px;
    }

    .redbg {
        text-align: center;
        background-color: red
    }

    .yellowbg {
        text-align: center;
        background-color: yellow
    }
</style>

<script src="~/Scripts/js/quanlylichnghi.js"></script>
<link href="~/Content/danhsachloptheogiaovien.css" rel="stylesheet" />

<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-calendar"></i> Quản lý lịch nghỉ</b>
</span>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>

        <div style="width: 100%; flex-direction:row; display: flex">

            <div style="flex:1" class="form-group valid" toggle-valid="ComboNhanVien">
                <label style="width:100%">Nhân viên:<span style="color:red">*</span></label>
                <input id="ComboNhanVien" type="text" class="input" />
                <span class="fa fa-exclamation-triangle icon"></span>
            </div>
            <div style="flex:1" class="form-group">
                <label style="width:100%">Mã số đò:</label>
                <input id="MaThuyen" type="text" style="width:100%" class="k-textbox" readonly />
            </div>

            <div style="flex:1" class="form-group">
                <label style="width:100%">Mã tổ nhóm:</label>
                <input id="MaToNhom" type="text" style="width:100%" class="k-textbox" readonly />
            </div>

        </div>
        <div class="form-group valid" toggle-valid="ComboLoai">
            <label style="width:100%">Ngày nghỉ:<span style="color:red">*</span></label>
            <input id="NgayNghi" type="text" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="ComboLoai">
            <label style="width:100%">Loại nghỉ:<span style="color:red">*</span></label>
            <input id="ComboLoai" type="text" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group">
            <label style="width:100%">Ghi Chú:</label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>
        </div>
    </form>
</div>
<div id="windowBaiKiemTra">
    <input type="hidden" id="ID_HocSinh" />
    <div id="lstBaiKiemTra" class="lstBKT">
        <div class="itemBKT">
            <div class="addnewfoler" onclick="ThemBaiKiemTra()"></div>
            <label class="BKTname">Tạo bài kiểm tra mới</label>
        </div>

    </div>
    <div class="row">
        <input id="fileBKT" type="file" />
    </div>
    <div style="margin:auto; width:100%">
        <div id="scrollView" style="width: 100%; height:calc(100vh - 50px)">
        </div>
    </div>
</div>
<div id="windowThemBKT">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="LuuBKT()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="HuyBKT()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <div class="form-group">
        <input id="ID_BaiKiemTra" type="hidden" />
    </div>
    <div class="form-group valid" toggle-valid="TenHocSinh">
        <label style="width:100%">Tên bài kiểm tra: <span style="color:red">*</span></label>
        <input id="TenBKT" placeholder="Tên bài kiểm tra" type="text" class="k-textbox input" />
        <span class="fa fa-exclamation-triangle icon"></span>
    </div>
</div>
