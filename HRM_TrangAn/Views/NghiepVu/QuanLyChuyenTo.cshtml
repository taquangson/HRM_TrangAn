@{
    ViewBag.Title = "Quản lý chuyển tổ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-cell {
        display: inline-grid;
        padding-block: 10px;
    }
</style>
<script src="~/Scripts/js/quanlychuyento.js"></script>
<link href="~/Content/danhsachloptheogiaovien.css" rel="stylesheet" />

<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-arrows-h"></i> Quản lý chuyến tổ</b>
</span>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
            <input id="NgayTao" type="hidden" />
        </div>

        @*<div style="width: 100%; flex-direction:row; display: flex" hidden>

            <div style="flex:1" class="form-group valid" toggle-valid="ComboNhanVien">
                <label style="width:100%">Nhân viên:<span style="color:red">*</span></label>
                <input id="ComboNhanVien" type="text" class="input" />
                <span class="fa fa-exclamation-triangle icon"></span>
            </div>
            <div style="flex:1" class="form-group">
                <label style="width:100%">Mã số đò:</label>
                <input id="MaThuyen" type="text" style="width:100%" class="k-textbox" readonly />
            </div>

            <div style="flex:1" class="form-group">
                <label style="width:100%">Mã tổ nhóm:</label>
                <input id="MaToNhom" type="text" style="width:100%" class="k-textbox" readonly />
            </div>

        </div>*@



        <div class="form-group valid" toggle-valid="Cong">
            <label style="width:100%">Công/Người:<span style="color:red">*</span></label>
            <input id="Cong" type="number" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group">
            <label style="width:100%">Ghi Chú:</label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>
        </div>
        <div style="width:100%;float:left">
            <div class="form-group">
                <label>Danh sách nhân viên:</label>
                <div id="gridNhanVien"></div>
            </div>
        </div>
    </form>
</div>

<div id="windowNhanVienToNhom">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="LuuAddNhanVienToNhom()"> <i class="fa fa-plus-square"> Lưu </i></button>
    </div>
    <div class="form-group">
        <label>Danh sách nhân viên:</label>
        <div id="gridAddNhanVienToNhom"></div>
    </div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="orders"></div>
</script>
