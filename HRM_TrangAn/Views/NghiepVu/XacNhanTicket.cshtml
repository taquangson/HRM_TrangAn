@{
    ViewBag.Title = "Xác nhận tích kê";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/xacnhanticket.js"></script>
<link href="~/Content/danhsachloptheogiaovien.css" rel="stylesheet" />

<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-male"></i> Xác nhận tích kê</b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Ngày chấm tích kê</label>
        <input style="width:100%" id="Ngay" />
    </div>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="LoadGridData()"> <i class="fa fa-search"> Tìm kiếm dữ liệu </i></button>
    @*<button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>*@
    @*<button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>*@
    <button class="k-button bg-green" onclick="XacNhan()"> <i class="fa fa-check"> Xác nhận ticket</i> </button>
    <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy ticket</i> </button>
    <button class="k-button bg-orange" onclick="TinhTicke()"> <i class="fa fa-refresh"> Tính lại ticket theo dữ liệu chấm công</i> </button>
    @*<button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>*@
</div>
<div class="row">
    <div id="grid"></div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="orders"></div>
</script>