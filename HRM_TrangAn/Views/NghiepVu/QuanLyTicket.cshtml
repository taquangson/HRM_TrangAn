@{
    ViewBag.Title = "Quản lý tích kê";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-cell {
        display: inline-grid;
        padding-block: 10px;
    }
</style>
<script src="~/Scripts/js/quanlyticket.js"></script>
<link href="~/Content/danhsachloptheogiaovien.css" rel="stylesheet" />

<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-ticket"></i> Quản lý tích kê</b>
</span>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="windowTicket">

    <div class="form-group valid" toggle-valid="GioiTinh">
        <label style="width:100%">Lý do: </label>
        <textarea id="" class="input k-textbox"></textarea>
    </div>
    <div class="toolBarMenu text-center">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Duyệt tích kê</i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy ticket</i> </button>
    </div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
            <input id="ID_NhanVien" type="hidden" />
        </div>
        <div style="width: 100%; flex-direction:row; display: flex">
            <div style="flex:1" class="form-group valid" toggle-valid="NgayDi">
                <label style="width:100%">Ngày lao động: </label>
                <input id="NgayDi" type="text" class="input" />
                <span class="fa fa-exclamation-triangle icon"></span>
            </div>
            <div style="flex:1" class="form-group valid" toggle-valid="ComboThuyen">
                <label style="width:100%">Mã số đò: </label>
                <input id="ComboThuyen" class="input" />
            </div>
        </div>
        <div style="width: 100%; flex-direction:row; display: flex">
            <div style="flex:1" class="form-group valid" toggle-valid="ComboTuyenDo">
                <label style="width:100%">Tuyến đò: </label>
                <input id="ComboTuyenDo" type="text" class="input" />
                <span class="fa fa-exclamation-triangle icon"></span>
            </div>
            <div style="flex:1" class="form-group">
                <label style="width:100%">Mã nhân viên: </label>
                <input id="MaNhanVien" style="width:100%" type="text" class="input k-textbox" readonly />
            </div>
        </div>
        <div class="form-group">
            <label style="width:100%">Ghi Chú:</label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>
        </div>

        <div class="form-group valid" toggle-valid="gridChamCong">
            <label>Lịch sử chấm công</label>
            <div id="gridChamCong"></div>
        </div>
    </form>
</div>

