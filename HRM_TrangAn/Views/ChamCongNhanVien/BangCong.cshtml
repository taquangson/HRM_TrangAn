
@{
    ViewBag.Title = "Tràng An - HRM System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/bangcong.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Công nhân sự</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Bảng công</b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Phòng ban</label>
        <input style="width:100%" id="treePhongBan" />
    </div>
    <div class="col-sm-2">
        <label style="width:100%">Tháng</label>
        <input style="width:100%" id="comboThang" />
    </div>
    @*<div class="col-sm-2">
        <label style="width:100%">Từ ngày</label>
        <input style="width:100%" id="TuNgay" />
    </div>
    <div class="col-sm-2">
        <label style="width:100%">Đến ngày</label>
        <input style="width:100%" id="DenNgay" />
    </div>*@
    <div class="col-sm-3">
        <label style="width:100%"> </label>

        @*<button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel </i></button>*@
    </div>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="LoadGridData()"> <i class="fa fa-search"> Tải dữ liệu </i></button>
    <button class="k-button bg-blue" onclick="GuiBangCong()"> <i class="fa fa-envelope"> Gửi email bảng công </i></button>
    @*<button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>*@
    @*<button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>*@
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">

    <div id="grid"></div>
</div>

<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <input type="hidden" id="ID_NhanVien" />
        <input type="hidden" id="ID_NhomNhanVien" />
        <div class="form-group valid" toggle-valid="Ten">
            <label id="TenDoiTuong" style="width:100%"></label>
            <input id="Ten" readonly type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="ComboCa">
            <label style="width:100%">Ca làm việc:</label>
            <div class="input" id="ComboCa"></div>
        </div>
        <div class="form-group valid" toggle-valid="BatDau">
            <label style="width:100%">Từ ngày:</label>
            <input id="BatDau" class="input" />
        </div>
        <div class="form-group valid" toggle-valid="KetThuc">
            <label style="width:100%">Đến ngày:</label>
            <input id="KetThuc" class="input" />
        </div>

    </form>
</div>