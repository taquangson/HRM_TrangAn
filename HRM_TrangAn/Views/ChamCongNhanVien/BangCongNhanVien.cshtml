

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HRM Tràng An - Bảng công nhân viên</title>
    <link href="~/Assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Assets/kendo/styles/kendo.mobile.all.min.css" rel="stylesheet" />
    <link href="~/Assets/kendo/styles/kendo.common.min.css" rel="stylesheet" />
    <link href="~/Assets/kendo/styles/kendo.rtl.min.css" rel="stylesheet" />
    <link href="~/Assets/kendo/styles/kendo.bootstrap.min.css" rel="stylesheet" />
    <link href="~/Assets/kendo/styles/kendo.bootstrap.mobile.min.css" rel="stylesheet" />
    <link href="~/Assets/kendo/kendo.ext.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Assets/kendo/kendo.all.min.js"></script>
    <script src="~/Scripts/jszip.js"></script>
    <script src="~/Assets/xlsx.js"></script>
    <link href="~/Assets/Common.css" rel="stylesheet" />
    <script>
        var from = '@Model.From.ToString("yyyy-MM-dd")';
        var to = '@Model.To.ToString("yyyy-MM-dd")';
        var idtaikhoan = @Model.ID_TaiKhoan;
    </script>
    <script src="~/Scripts/js/bangcongnhanvien.js"></script>
</head>

<body>
    <div style="width:99%; height:calc(100vh);margin:auto">
        <div style="width: 100%; text-align: center; background-color: #523b71; display: flex; flex-direction: row;">
            <img style=" height: 50px; width: 50px; margin-left: 10px;" src="~/Images/img.png" />
            <span style="color: #fff; text-align: center; width: 100%; line-height: 50px;">HỆ THỐNG QUẢN LÝ NHÂN SỰ - TRÀNG AN</span>
        </div>
        <h3>@Model.Title </h3>
        <p>- Công chuẩn của tháng: 26</p>
        <p>- Công thực tế đi làm: <span id="congtt"></span></p>
        @foreach (string i in Model.LichNghi)
        {
            <p>
                - @i
            </p>
        }
        @if (Model.ShowbtnChotCong)
        {
            <button onclick="ChotCong()" style="background: linear-gradient(0deg, #4b4b4b, #582370, #5e2c74, #582370, #4b4b4b); color: white !important;" class="k-button"><i class="fa fa-check"> Xác nhận bảng công</i>.</button>
        }
        else
        {
            <label style="background: green; color: white !important;" class="k-button"><i class="fa fa-check"> Đã xác nhận bảng công</i>.</label>
        }
        <div id="grid"></div>
    </div>
</body>
</html>
