<div >
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Cập nhật </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <!--<div class="form-group valid" toggle-valid="TenTaiKhoan">-->
        @*// class có thêm valid*@
        <!--<label style="width:100%">Tên tài khoản:<span style="color:red">*</span></label>-->
        @*<a class="k-button btn-category" onclick="OpenDanhMucLoi()"><i class="fa fa-plus"></i></a>*@
        <!--<input id="TenTaiKhoan" type="text" class="k-textbox input" />--> @*class có thêm input*@
        <!--<span class="fa fa-exclamation-triangle icon"></span>--> @*//có thêm icon cuối  thẻ input*@
        <!--</div>-->

        <div class="form-group valid" toggle-valid="TenCongTy">
            <label style="width:100%">Tên công ty: <span style="color:red">*</span></label>
            <input id="TenCongTy" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="MaCongTy">
            <label style="width:100%">Mã công ty: <span style="color:red">*</span></label>
            <input id="MaCongTy" type="text" class="k-textbox input" /> @*input validate ko dduowwcj để style="width:100%"*@
            <span class="fa fa-exclamation-triangle icon"></span>

        </div>
        <div class="form-group">
            <label style="width:100%">Địa chỉ: </label>
            <textarea id="DiaChi" type="text" style="width:100%" class="k-textbox"></textarea>

        </div>
        <div class="form-group">
            <label style="width:100%">Phó giám đốc: </label>
            <input id="PhoGiamDoc" type="text" style="width:100%" class="k-textbox" />

        </div>
        <div class="form-group">
            <label style="width:100%">Ban quản lý: </label>
            <input id="BanQuanLy" type="text" style="width:100%" class="k-textbox" />

        </div>
        <div class="form-group">
            <label style="width:100%">Kế toán: </label>
            <input id="KeToan" type="text" style="width:100%" class="k-textbox" />

        </div>



        <div class="form-group">
            <label style="width:100%">Ghi chú: </label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>

        </div>



    </form>
</div>
