
@{
    ViewBag.Title = "Tràng An - HRM System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-cell {
        display: inline-grid;
        padding-block: 10px;

    }
</style>
<script src="~/Scripts/js/danhmucnguoigiamsat.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Danh mục</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Danh mục người giám sát</b>
</span>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-orange" onclick="openCopyWindow()"> <i class="fa fa-clone"> Nhân bản</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="NhapExcel()"> <i class="fa fa-file-excel-o"> Nhập excel</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <div class="form-group valid" toggle-valid="ComboNhom">
            <label style="width:100%">Nhóm:<span style="color:red">*</span></label>
            <input id="ComboNhom" type="text" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div id="comboGiamSatTK" class="form-group valid" toggle-valid="ComboTaiKhoan">
            <label style="width:100%">Người giám sát:<span style="color:red">*</span></label>
            <input id="ComboTaiKhoan" type="text" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div id="comboGiamSatNV" class="form-group valid" toggle-valid="ComboNhanVien">
            <label style="width:100%">Người giám sát:<span style="color:red">*</span></label>
            <input id="ComboNhanVien" type="text" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div id="txtGiamSat" class="form-group valid" toggle-valid="TenGiamSat">
            <label style="width:100%">Người giám sát:<span style="color:red">*</span></label>
            <input id="TenGiamSat" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group">
            <label style="width:100%">Số điện thoại:</label>
            <input id="DienThoai" type="text" style="width:100%" class="k-textbox" />
        </div>
        <div class="form-group">
            <label style="width:100%">Địa điểm làm việc:</label>
            <textarea id="DiaDiemLamViec" rea type="text" style="width:100%" class="k-textbox"></textarea>
        </div>
        <div class="form-group">
            <label style="width:100%">Ghi Chú:</label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>
        </div>
    </form>
</div>

<div id="windowImport" style="visibility:hidden">
    <div class="toolBarMenu">
        <button class="k-button bg-green" onclick="DownloadTemp(0)"> <i class="fa fa-file-excel-o"> Tải mẫu excel(Nhân viên)</i> </button>
        <button class="k-button bg-green" onclick="DownloadTemp(1)"> <i class="fa fa-file-excel-o"> Tải mẫu excel(Lao động)</i> </button>
        <button class="k-button bg-green" onclick="DownloadTemp(2)"> <i class="fa fa-file-excel-o"> Tải mẫu excel(Khác)</i> </button>
        <button class="k-button bg-blue" onclick="LuuImport()"> <i class="fa fa-plus-square"> Lưu dữ liệu excel</i></button>
        <button class="k-button bg-red" onclick="HuyImport()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formImport">
        <br>
        <div class="form-group">
            <label style="width:100%">Chọn file excel: </label>
            <input type="file" id="file" />
        </div>

        <div class="form-group">
            <label>Dữ liệu trong file excel</label>
            <div id="gridImport"></div>
        </div>
    </form>
</div>
