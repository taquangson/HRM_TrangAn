@{
    ViewBag.Title = "Tràng An - HRM System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/doanhsoluongkhach.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Danh mục</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Danh mục doanh số lượng khách</b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Từ ngày</label>
        <input style="width:100%" id="TuNgaySearch" />
    </div>
    <div class="col-sm-2">
        <label style="width:100%">Đến ngày</label>
        <input style="width:100%" id="DenNgaySearch" />
    </div>
    <div class="col-sm-3" style="margin-top: 5px">
        <label style="width:100%"> </label>
        <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Xem báo cáo </i></button>
    </div>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <div class="form-group valid">
            <label style="width:100%">Từ ngày: <span style="color:red">*</span></label>
            <input id="TuNgay" style="width:100%" class="input" />
        </div>
        <div class="form-group valid">
            <label style="width:100%">Đến ngày: <span style="color:red">*</span></label>
            <input id="DenNgay" style="width:100%" class="input" />
        </div>
        <div class="form-group valid" toggle-valid="Ten">
            <label style="width:100%">Doanh Số: <span style="color:red">*</span></label>
            <input id="DoanhSo" type="number" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="Ma">
            <label style="width:100%">Lượng khách: <span style="color:red">*</span></label>
            <input id="LuongKhach" type="number" class="k-textbox input" />
        </div>
        <div class="form-group">
            <div id="gridNhanVien"></div>
        </div>
    </form>
</div>
