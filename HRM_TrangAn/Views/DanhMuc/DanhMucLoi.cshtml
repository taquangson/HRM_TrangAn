
@{
    ViewBag.Title = "Tràng An - HRM System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/danhmucloi.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Danh mục</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Danh mục lỗi xử phạt</b>
</span>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>

<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <div class="form-group valid" toggle-valid="TenLoi">
            <label style="width:100%">Tên lỗi: <span style="color:red">*</span></label>
            <input id="TenLoi" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="MoTa">
            <label style="width:100%">Mô tả: </label>
            <input id="MoTa" type="text" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="PhatTien">
            <label style="width:100%">Phạt tiền:</label>
            <input id="PhatTien" type="number" min="0" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="PhatCong">
            <label style="width:100%">Phạt công:</label>
            <input id="PhatCong" type="number" min="0" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="ComboLoaiLoi">
            <label style="width:100%">Loại vi phạm</label>
            <div style="width:100%" id="ComboLoaiLoi"></div>
        </div>
        <div class="form-group valid" toggle-valid="SoPhutDiMuon">
            <label style="width:100%">Số phút đi muộn:</label>
            <input id="SoPhutDiMuon" type="number" min="0" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="SoPhutVeSom">
            <label style="width:100%">Số phút về sớm:</label>
            <input id="SoPhutVeSom" type="number" min="0" class="k-textbox input" />
        </div>
        <div class="form-group valid" toggle-valid="SoLanViPham">
            <label style="width:100%">Xử phạt từ số lần vi phạm:</label>
            <input id="SoLanViPham" type="number" min="0" class="k-textbox input" />
        </div>
    </form>
</div>