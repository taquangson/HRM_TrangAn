@using HRM_TrangAn.DataAccess.Models;
@{
    Layout = null;
    int star1 = 0;
    int star2 = 0;
    int star3 = 0;
    int star4 = 0;
    int star5 = 0;

    int sum = 0;
    float avg = 0;
    foreach (RatingLaiDoModel r in Model.rating)
    {
        sum += r.Rate;
        if (r.Rate == 1)
        {
            star1++;
        }
        else if (r.Rate == 2)
        {
            star2++;
        }
        else if (r.Rate == 3)
        {
            star3++;
        }
        else if (r.Rate == 4)
        {
            star4++;
        }
        else if (r.Rate == 5)
        {
            star5++;
        }
    }
    if (Model.rating.Count == 0)
    {
        avg = 0;
    }
    else
    { avg = sum / Model.rating.Count; 
    }
    float pstar1 = (float)star1 * 100 / (float)Model.rating.Count;
    float pstar2 = (float)star2 * 100 / (float)Model.rating.Count;
    float pstar3 = (float)star3 * 100 / (float)Model.rating.Count;
    float pstar4 = (float)star4 * 100 / (float)Model.rating.Count;
    float pstar5 = (float)star5 * 100 / (float)Model.rating.Count;
}

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/img_OX2_icon.ico" rel="shortcut icon" type="image/x-icon" />
    <title>Đánh giá lái đò</title>


    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <link href="~/Assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <style>
        body {
            padding-top: 20px;
            height: 100vh;
            background: linear-gradient( 0deg, #191919,#6b1a8f);
        }

        .btn-grey {
            background-color: #D8D8D8;
            color: #FFF;
        }

        .rating-block {
            background-color: #FAFAFA;
            border: 1px solid #EFEFEF;
            padding: 15px 15px 20px 15px;
            border-radius: 3px;
        }

        .bold {
            font-weight: 700;
        }

        .padding-bottom-7 {
            padding-bottom: 7px;
        }

        .review-block {
            background-color: #FAFAFA;
            border: 1px solid #EFEFEF;
            padding: 15px;
            border-radius: 3px;
            margin-bottom: 15px;
        }

        .review-block-name {
            font-size: 12px;
            margin: 10px 0;
        }

        .review-block-date {
            font-size: 12px;
        }

        .review-block-rate {
            font-size: 13px;
            margin-bottom: 15px;
        }

        .review-block-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .review-block-description {
            font-size: 13px;
        }

        .animated {
            -webkit-transition: height 0.2s;
            -moz-transition: height 0.2s;
            transition: height 0.2s;
        }

        .stars {
            margin: 20px 2px;
            font-size: 28px;
            color: #fffe00;
        }

            .stars .glyphicon {
                margin-left: 10px;
            }

        .avatar {
            vertical-align: middle;
            width: 100px;
            height: 100px;
            border-radius: 20%;
        }
    </style>
    <script>
