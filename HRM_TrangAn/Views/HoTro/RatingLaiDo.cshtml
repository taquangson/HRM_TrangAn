        $(document).ready(function () {
            $("#rating-result").hide();
            $("#rating-submit").show();
            var reviewBox = $('#post-review-box');
            var newReview = $('#ghichu');
            var openReviewBtn = $('#open-review-box');
            var ratingsField = $('#ratings-hidden');

            reviewBox.slideDown(400, function () {
                $('#ghichu').trigger('autosize.resize');
                newReview.focus();
            });
            openReviewBtn.fadeOut(100);
            $('.starrr').on('starrr:change', function (e, value) {
                ratingsField.val(value);
            });
            $("#submit").click(function () {
                if ($("#khachhang").val() == '' || $("#ratings-hidden").val() == '') {
                    alert("Vui lòng điền đầy đủ thông tin!");
                } else {
                    $.ajax({
                        url: '/HoTro/GuiDanhGia',
                        data: {
                            MaNhanVien: @Model.MaNhanVien,
                            ID_NhanVien: @Model.ID,
                            Rate: $("#ratings-hidden").val(),
                            KhachHang: $("#khachhang").val(),
                            GhiChu: $("#ghichu").val()
                        },
                        type: 'POST',
                    }).done(function successCallback(response) {
                        $("#rating-result").show();
                        $("#rating-submit").hide();
                    });
                }
            })
        })
    </script>
</head>

<body>
    <div id="rating-submit" class="container">
        <div class="row" id="post-review-box">
            <div class="col-md-12">
                <form>
                    <hr />
                    <h4 style="color:#fff">Đánh giá lái đò: @Model.TenDayDu</h4>
                    @if (Model.AnhDaiDien != null)
                    {
                        <img class="avatar" src="@Model.AnhDaiDien.FilePath" />
                    }
                    <input id="ratings-hidden" name="rating" type="hidden">
                    <div class="text-left">
                        <div class="stars starrr" data-rating="0"></div>
                    </div>
                    <input placeholder="Vui lòng nhập tên để đánh giá" type="text" class="form-control" id="khachhang" />
                    <br />
                    <textarea class="form-control animated" cols="50" id="ghichu" name="comment" placeholder="Nhập nhận xét của bạn tại đây..." rows="5"></textarea>
                    <hr />
                    <div class="text-right">
                        <a class="btn btn-success btn-md" id="submit"><span class='glyphicon glyphicon-send'></span> Gửi đánh giá</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div id="rating-result" class="container">

        <div class="row">
            <div class="col-sm-6">
                <div class="rating-block">
                    <h4>Lái đò: @Model.TenDayDu</h4>
                    @if (Model.AnhDaiDien != null)
                    {
                        <img class="avatar" src="@Model.AnhDaiDien.FilePath" />
                    }
                    <h4>Điểm đánh giá trung bình</h4>
                    <h2 class="bold padding-bottom-7">@avg <small>/ 5</small></h2>
                    <button type="button" class="btn btn-warning btn-sm" aria-label="Left Align">
                        <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn btn-warning btn-sm" aria-label="Left Align">
                        <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn btn-warning btn-sm" aria-label="Left Align">
                        <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn btn-default btn-grey btn-sm" aria-label="Left Align">
                        <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn btn-default btn-grey btn-sm" aria-label="Left Align">
                        <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                    </button>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="rating-block">
                    <h4>Lượt đánh giá</h4>

                    <div class="container">
                        <div class="pull-left" style="width:35px; line-height:1;">
                            <div style="height:9px; margin:5px 0;">5 <span class="glyphicon glyphicon-star"></span></div>
                        </div>
                        <div class="pull-left" style="width:180px;">
                            <div class="progress" style="height:9px; margin:8px 0;">
                                <div class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="5" aria-valuemin="0" aria-valuemax="5" style="width: @(pstar5.ToString()+"%")">
                                </div>
                            </div>
                        </div>
                        <div class="pull-left" style="margin-left:10px;">@star5 </div>
                    </div>
                    <div class="container">
                        <div class="pull-left" style="width:35px; line-height:1;">
                            <div style="height:9px; margin:5px 0;">4 <span class="glyphicon glyphicon-star"></span></div>
                        </div>
                        <div class="pull-left" style="width:180px;">
                            <div class="progress" style="height:9px; margin:8px 0;">
                                <div class="progress-bar progress-bar-primary" role="progressbar" aria-valuenow="4" aria-valuemin="0" aria-valuemax="5" style="width: @(pstar4.ToString()+"%")">
                                </div>
                            </div>
                        </div>
                        <div class="pull-left" style="margin-left:10px;">@star4</div>
                    </div>
                    <div class="container">
                        <div class="pull-left" style="width:35px; line-height:1;">
                            <div style="height:9px; margin:5px 0;">3 <span class="glyphicon glyphicon-star"></span></div>
                        </div>
                        <div class="pull-left" style="width:180px;">
                            <div class="progress" style="height:9px; margin:8px 0;">
                                <div class="progress-bar progress-bar-info" role="progressbar" aria-valuenow="3" aria-valuemin="0" aria-valuemax="5" style="width: @(pstar3.ToString()+"%")">
                                </div>
                            </div>
                        </div>
                        <div class="pull-left" style="margin-left:10px;">@star3</div>
                    </div>
                    <div class="container">
                        <div class="pull-left" style="width:35px; line-height:1;">
                            <div style="height:9px; margin:5px 0;">2 <span class="glyphicon glyphicon-star"></span></div>
                        </div>
                        <div class="pull-left" style="width:180px;">
                            <div class="progress" style="height:9px; margin:8px 0;">
                                <div class="progress-bar progress-bar-warning" role="progressbar" aria-valuenow="2" aria-valuemin="0" aria-valuemax="5" style="width: @(pstar2.ToString()+"%")">
                                </div>
                            </div>
                        </div>
                        <div class="pull-left" style="margin-left:10px;">@star2</div>
                    </div>
                    <div class="container">
                        <div class="pull-left" style="width:35px; line-height:1;">
                            <div style="height:9px; margin:5px 0;">1 <span class="glyphicon glyphicon-star"></span></div>
                        </div>
                        <div class="pull-left" style="width:180px;">
                            <div class="progress" style="height:9px; margin:8px 0;">
                                <div class="progress-bar progress-bar-danger" role="progressbar" aria-valuenow="1" aria-valuemin="0" aria-valuemax="5" style="width: @(pstar1.ToString()+"%")">
                                </div>
                            </div>
                        </div>
                        <div class="pull-left" style="margin-left:10px;">@star1</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <hr />
                <div class="review-block">
                    @foreach (RatingLaiDoModel r in Model.rating)
                    {
                        <div class="row">
                            <div class="col-sm-3 text-center">
                                <img src="http://dummyimage.com/60x60/666/ffffff&text=No+Image" class="img-rounded">
                                <div class="review-block-name"><a href="#">@r.KhachHang</a></div>
                                <div class="review-block-date">@r.NgayTao.ToString("dddd dd/MM/yyyy")<br /></div>
                            </div>
                            <div class="col-sm-9">
                                <div class="review-block-rate">
                                    @for (int i = 0; i < r.Rate; i++)
                                    {
                                        <button type="button" class="btn btn-warning btn-xs" aria-label="Left Align">
                                            <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                                        </button>
                                    }

                                    @for (int j = 0; j < (5 - r.Rate); j++)
                                    {
                                        <button type="button" class="btn btn-default btn-grey btn-xs" aria-label="Left Align">
                                            <span class="glyphicon glyphicon-star" aria-hidden="true"></span>
                                        </button>
                                    }

                                </div>
                                <div class="review-block-title">Nội dung đánh giá</div>
                                <div class="review-block-description">@r.GhiChu</div>
                            </div>
                        </div>
                        <hr />
                    }
                </div>
            </div>
        </div>

    </div> <!-- /container -->
</body>
</html>
