
@{
    ViewBag.Title = "Báo cáo tổng hợp tích kê theo năm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/baocao_js/baocaotickenam.js"></script>
<div id="rootContainer" style="display:none">
    <div class="row">
        <h2><b>Báo cáo tổng hợp tích kê theo năm</b></h2>
    </div>
    <div class="row" style="margin-top:10px;">

        <div class="col-sm-2">
            <label style="width:100%">Năm</label>
            <input style="width:100%" id="Nam" />
        </div>

        <div class="col-sm-3">
            <label style="width:100%"> </label>
            <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Xem báo cáo </i></button>
            <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel </i></button>
        </div>
    </div>
    <div class="row" style="margin-top:20px;">
        <div id="gridData"></div>
    </div>
</div>