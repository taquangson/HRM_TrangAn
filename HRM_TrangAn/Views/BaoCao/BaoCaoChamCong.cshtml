
@{
    ViewBag.Title = "Tràng An - HRM System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/baocao_js/baocaochamcong.js"></script>
<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Công nhân sự</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Báo cáo chấm công</b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Phòng ban</label>
        <input style="width:100%" id="treePhongBan" />
    </div>
    <div class="col-sm-5">
        <label style="width:100%">Nhân viên</label>
        <input style="width:100%" id="comboNhanVien" />
    </div>
</div>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Từ ngày</label>
        <input style="width:100%" id="TuNgay" />
    </div>
    <div class="col-sm-2">
        <label style="width:100%">Đến ngày</label>
        <input style="width:100%" id="DenNgay" />
    </div>
    <div class="col-sm-3">
        <label style="width:100%"> </label>

        @*<button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel </i></button>*@
    </div>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Tải dữ liệu </i></button>
    @*<button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>*@
    @*<button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>*@
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">

    <div id="grid"></div>
</div>

<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <input type="hidden" id="ID_HoSoNhanSu" />
        <input type="hidden" id="ID_TaiKhoan" />
        <input type="hidden" id="Ngay" />
        <div class="form-group valid" toggle-valid="Ten">
            <label style="width:100%">Tên nhân viên</label>
            <input id="TenNhanVien" readonly type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="ComboCa">
            <label style="width:100%">Ca làm việc:<span style="color:red">*</span></label>
            <div class="input" id="ComboCa"></div>
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="CheckIn">
            <label style="width:100%">Check in:<span style="color:red">*</span></label>
            <input id="CheckIn" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="CheckOut">
            <label style="width:100%">Check out:<span style="color:red">*</span></label>
            <input id="CheckOut" class="input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="SoCong">
            <label style="width:100%">Số công: <span style="color:red">*</span></label>
            <input id="SoCong" step="0.25" type="number" min="0" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="SoCongTangCa">
            <label style="width:100%">Số công tăng ca: <span style="color:red">*</span></label>
            <input id="SoCongTangCa" step="0.25" type="number" min="0" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="TrucDem">
            <label style="width:100%">Trực đêm: <span style="color:red">*</span></label>
            <input id="TrucDem" step="0.25" type="number" min="0" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="TrucDemDenTran">
            <label style="width:100%">Trực đêm Đền Trần: <span style="color:red">*</span></label>
            <input id="TrucDemDenTran" step="0.25" type="number" min="0" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="XuatAn">
            <label style="width:100%">Số xuất ăn: <span style="color:red">*</span></label>
            <input id="XuatAn" step="0.25" type="number" min="0" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
    </form>
</div>