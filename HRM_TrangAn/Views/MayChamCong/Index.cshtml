<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    <button class="k-button bg-orange" onclick="openCopyWindow()"> <i class="fa fa-clone"> Nhân bản</i> </button>
    <button class="k-button bg-red" onclick="Xoa()"> <i class="fa fa-close"> Xóa</i> </button>
    <button class="k-button bg-green" onclick="NhapExcel()"> <i class="fa fa-file-excel-o"> Nhập excel</i> </button>
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>

</div>
<div class="row">
    <div id="grid"></div>
</div>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <!--<div class="form-group valid" toggle-valid="TenTaiKhoan">-->
        @*// class có thêm valid*@
        <!--<label style="width:100%">Tên tài khoản:<span style="color:red">*</span></label>-->
        @*<a class="k-button btn-category" onclick="OpenDanhMucLoi()"><i class="fa fa-plus"></i></a>*@
        <!--<input id="TenTaiKhoan" type="text" class="k-textbox input" />--> @*class có thêm input*@
        <!--<span class="fa fa-exclamation-triangle icon"></span>--> @*//có thêm icon cuối  thẻ input*@
        <!--</div>-->

        <div class="form-group valid" toggle-valid="TenThietBi">
            <label style="width:100%">Tên thiết bị: <span style="color:red">*</span></label>
            <input id="TenThietBi" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>

        </div>
        <div class="form-group valid" toggle-valid="MaThietBi">
            <label style="width:100%">Mã thiết bị: <span style="color:red">*</span></label>
            <input id="MaThietBi" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>

        </div>
        <div class="form-group valid" toggle-valid="DiaChiIP">
            <label style="width:100%">Địa chỉ IP: <span style="color:red">*</span></label>
            <input id="DiaChiIP" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>

        </div>
        <div class="form-group valid" toggle-valid="Port">
            <label style="width:100%">Port: <span style="color:red">*</span></label>
            <input id="Port" type="text" class="k-textbox input" />
            <span class="fa fa-exclamation-triangle icon"></span>

        </div>
        <div class="form-group">
            <label style="width:100%">Thông tin thiết bị: </label>
            <textarea id="ThongTinThietBi" type="text" style="width:100%" class="k-textbox"></textarea>

        </div>
        <div class="form-group">
            <label style="width:100%">Ghi chú: </label>
            <textarea id="GhiChu" type="text" style="width:100%" class="k-textbox"></textarea>

        </div>



    </form>
</div>
<div id="windowImport" style="visibility:hidden">
    <div class="toolBarMenu">
        <button class="k-button bg-green" onclick="DownloadTemp()"> <i class="fa fa-file-excel-o"> Tải mẫu excel</i> </button>
        <button class="k-button bg-blue" onclick="LuuImport()"> <i class="fa fa-plus-square"> Lưu dữ liệu excel</i></button>
        <button class="k-button bg-red" onclick="HuyImport()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formImport">
        <br>
        <div class="form-group">
            <label style="width:100%">Chọn file excel: </label>
            <input type="file" id="file" />
        </div>

        <div class="form-group">
            <label>Dữ liệu trong file excel</label>
            <div id="gridImport"></div>
        </div>
    </form>
</div>