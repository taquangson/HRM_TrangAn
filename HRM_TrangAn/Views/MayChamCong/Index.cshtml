    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-cogs"></i> Danh mục</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-user"></i> Danh mục máy chấm công</b>
</span>
