@{
    ViewBag.Title = "Xác nhận tích kê";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/js/quanlynghiphepnam.js"></script>

<div id="dialogRoot"></div>
<span class="sitemap">
    <a href="/Home/Index"><b><i class="fa fa-home"></i> Home</b></a>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-briefcase"></i> Nghiệp vụ</b>
    <i class="fa fa-chevron-right"></i>
    <b><i class="fa fa-male"></i> Quản lý nghỉ phép năm </b>
</span>
<div class="row" style="margin-top:10px;">
    <div class="col-sm-2">
        <label style="width:100%">Năm</label>
        <input style="width:100%" id="Nam" />
    </div>
</div>
<div class="row toolBarMenu">
    <button class="k-button bg-blue" onclick="TimKiem()"> <i class="fa fa-search"> Tìm kiếm </i></button>
    @*<button class="k-button bg-blue" onclick="ThemMoi()"> <i class="fa fa-plus-square"> Thêm </i></button>*@
    <button class="k-button bg-orange" onclick="openEditWindow()"> <i class="fa fa-wrench"> Sửa</i> </button>
    @*<button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy ticket</i> </button>*@
    @*<button class="k-button bg-green" onclick="XacNhan()"> <i class="fa fa-check"> Xác nhận ticket</i> </button>*@
    @*<button class="k-button bg-orange" onclick="TinhTicke()"> <i class="fa fa-refresh"> Tính lại ticket theo dữ liệu chấm công</i> </button>*@
    <button class="k-button bg-green" onclick="XuatExcel()"> <i class="fa fa-file-excel-o"> Xuất excel</i> </button>
</div>
<div class="row">
    <div id="grid"></div>
</div>
<script type="text/x-kendo-template" id="template">
    <div class="orders"></div>
</script>
<div style="visibility:hidden" id="window">
    <div class="toolBarMenu">
        <button class="k-button bg-blue" onclick="Luu()"> <i class="fa fa-plus-square"> Lưu </i></button>
        <button class="k-button bg-red" onclick="Huy()"> <i class="fa fa-close"> Hủy</i> </button>
    </div>
    <form id="formChiTiet">
        <div class="form-group">
            <input id="ID" type="hidden" />
        </div>
        <div class="form-group valid" toggle-valid="TenDayDu">
            <label style="width:100%">Tên nhân viên: </label>
            <input id="TenDayDu" type="text" class="k-textbox input" readonly />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group valid" toggle-valid="MaNhanVien">
            <label style="width:100%">Mã nhân viên: </label>
            <input id="MaNhanVien" type="text" class="k-textbox input" readonly />
            <span class="fa fa-exclamation-triangle icon"></span>
        </div>
        <div class="form-group">
            <label>Danh sách nhân viên </label>
            <div id="gridNgayNghi"></div>
        </div>
    </form>
</div>